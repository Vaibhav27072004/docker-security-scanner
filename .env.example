# ============================================================
# Docker Security Scanner — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to version control!

# ─── Scanner Configuration ───────────────────────────────────
# Comma-separated severity levels to fail the scan on
# Options: CRITICAL, HIGH, MEDIUM, LOW, UNKNOWN
FAIL_ON_SEVERITY=CRITICAL,HIGH

# Maximum number of CRITICAL CVEs before hard-fail (0 = any)
CRITICAL_THRESHOLD=0

# Maximum number of HIGH CVEs before hard-fail (0 = disabled)
HIGH_THRESHOLD=10

# ─── Trivy Settings ──────────────────────────────────────────
# Trivy binary path (leave blank if in PATH)
TRIVY_PATH=

# Trivy DB cache directory
TRIVY_CACHE_DIR=.trivy-cache

# Skip Trivy DB update (useful in air-gapped environments)
TRIVY_SKIP_UPDATE=false

# ─── Hadolint Settings ───────────────────────────────────────
HADOLINT_PATH=

# Hadolint config file path (optional)
HADOLINT_CONFIG=.hadolint.yaml

# Comma-separated rule IDs to ignore
HADOLINT_IGNORE=

# ─── Gitleaks Settings ───────────────────────────────────────
GITLEAKS_PATH=

# Gitleaks config file path (optional)
GITLEAKS_CONFIG=.gitleaks.toml

# ─── Reporting ───────────────────────────────────────────────
# Output directory for generated reports
REPORT_OUTPUT_DIR=reports

# Formats to generate: html, json, markdown (comma-separated)
REPORT_FORMATS=html,json,markdown

# GitHub token for posting PR comments and check runs
# Required only for GitHub Actions integration
GITHUB_TOKEN=

# Slack webhook URL for critical finding notifications
SLACK_WEBHOOK_URL=

# Email settings for notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_RECIPIENTS=

# ─── SBOM Settings ───────────────────────────────────────────
# SBOM formats to generate: cyclonedx, spdx (comma-separated)
SBOM_FORMATS=cyclonedx,spdx

# ─── Logging ─────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (leave blank to log to stdout only)
LOG_FILE=

# ─── Docker Registry ─────────────────────────────────────────
# Registry credentials for private images
REGISTRY_URL=
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
