# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Secure App
# Use a secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)
# in production. This file shows required variables ONLY.
# ─────────────────────────────────────────────────────────────────────────────

# Application
PORT=8080
SECRET_KEY=change-this-to-a-randomly-generated-secret-in-production

# Database — reference a secrets manager in production
# e.g. DATABASE_URL=$(aws secretsmanager get-secret-value --secret-id db-url)
DATABASE_URL=postgresql://user:password@localhost:5432/mydb
